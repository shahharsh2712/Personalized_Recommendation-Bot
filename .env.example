# Embeddings: ollama (free/local), openai, or none (Render / no-Ollama deploy)
EMBEDDING_PROVIDER=ollama
# LIGHTWEIGHT_DEPLOY=1
# SKIP_OLLAMA_WAIT=1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OPENAI_API_KEY=your_openai_api_key
OPENAI_EMBED_MODEL=text-embedding-3-small
PERPLEXITY_API_KEY=your_perplexity_api_key
PRODUCT_HUNT_DEVELOPER_TOKEN=your_product_hunt_token
MONGODB_URI=mongodb://localhost:27017/
RECOMMENDATION_DB_NAME=app_recommendations

# Email: use smtp (Gmail) or sendgrid
EMAIL_PROVIDER=smtp
SENDER_EMAIL=your_email@gmail.com
SENDER_NAME=App Recommendations
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# Only if EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key
