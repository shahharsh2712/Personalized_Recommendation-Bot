   # Example environment variables for the Personalized Product Recommendation System

   # OpenAI API key for generating embeddings
   OPENAI_API_KEY=your_openai_api_key_here

   # Perplexity API key for product enrichment
   PERPLEXITY_API_KEY=your_perplexity_api_key_here

   # MongoDB connection URI
   MONGODB_URI=mongodb://localhost:27017/

   # MongoDB database name
   RECOMMENDATION_DB_NAME=app_recommendations

   # SendGrid API key for sending emails
   SENDGRID_API_KEY=your_sendgrid_api_key_here

   # The email address to send recommendations from
   SENDER_EMAIL=your_email@example.com

   # (Optional) The name to display as sender
   SENDER_NAME=App Recommendations